#/* $begin ncopy-ys */
##################################################################
# ncopy.ys - Copy a src block of len words to dst.
# Return the number of positive words (>0) contained in src.
#
# Include your name and ID here.
#
# Describe how and why you modified the baseline code.
#
##################################################################
# Do not modify this portion
# Function prologue.
# %rdi = src, %rsi = dst, %rdx = len
ncopy:

##################################################################
# You can modify this portion
	# Loop header
	iaddq $-10,%rdx	#一次处理9个数
	jl remain #少于9个跳转，一次处理两个

Loop1:	
	mrmovq (%rdi), %r8	
	mrmovq 8(%rdi),%r9	
	mrmovq 16(%rdi),%r10
	mrmovq 24(%rdi),%r11
	mrmovq 32(%rdi),%r12
	mrmovq 40(%rdi),%r13
	mrmovq 48(%rdi),%r14
	mrmovq 56(%rdi),%rbx
	mrmovq 64(%rdi),%rcx	
	mrmovq 72(%rdi),%rbp	
	rmmovq %r8,(%rsi)	
	rmmovq %r9,8(%rsi)
	rmmovq %r10,16(%rsi)
	rmmovq %r11,24(%rsi)
	rmmovq %r12,32(%rsi)
	rmmovq %r13,40(%rsi)
	rmmovq %r14,48(%rsi)
	rmmovq %rbx,56(%rsi)
	rmmovq %rcx,64(%rsi)
	rmmovq %rbp,72(%rsi)
	iaddq $80, %rdi	
	iaddq $80, %rsi	
	andq %r8, %r8	#val>0	
	jle l1			
	iaddq $1,%rax

l1:						
	andq %r9,%r9
	jle l2
	iaddq $1, %rax	

l2:
	andq %r10,%r10
	jle l3
	iaddq $1,%rax

l3:
	andq %r11,%r11
	jle l4
	iaddq $1,%rax

l4:
	andq %r12,%r12
	jle l5
	iaddq $1,%rax

l5:
	andq %r13,%r13
	jle l6
	iaddq $1,%rax

l6:
	andq %r14,%r14
	jle l7
	iaddq $1,%rax

l7:
	andq %rbx,%rbx
	jle l8
	iaddq $1,%rax

l8:
	andq %rcx,%rcx
	jle l9
	iaddq $1,%rax

l9:
	andq %rbp,%rbp
	jle last
	iaddq $1,%rax

last:
	iaddq $-10, %rdx			
	jge Loop1	#够9个进入下一次循环

remain:
	iaddq $8,%rdx			
	jl one #剩最后一个或者0个

Loop2:
	mrmovq (%rdi),%r8 
	mrmovq 8(%rdi),%r9
	rmmovq %r8,(%rsi)
	rmmovq %r9,8(%rsi)
	iaddq $16,%rdi
	iaddq $16,%rsi
	andq %r8,%r8
	jle ll1
	iaddq $1,%rax

ll1:
	andq %r9,%r9
	jle llast
	iaddq $1,%rax

llast:
	iaddq $-2,%rdx
	jge Loop2

one:
	iaddq $1,%rdx		#最后一个或者0个
	jl Done
	mrmovq (%rdi), %r8
	rmmovq %r8, (%rsi)		
	andq %r8, %r8	
	jle Done
	iaddq $1, %rax	


##################################################################
# Do not modify the following section of code
# Function epilogue.
Done:
	ret
##################################################################
# Keep the following label at the end of your function
End:
#/* $end ncopy-ys */
